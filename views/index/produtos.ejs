    <div class="capa">
        <h1>Produtos</h1>
    </div>

    <div class="container mt-4">
        <!-- TODOS OS PRODUTOS (paginados) -->
        <div class="row g-4">

            <% produtos.forEach(p => { %>
                <div class="col-md-3">
                    <div class="card product-card h-100">

                        <%
                        const imagens = [
                            '../../public/img/produtos/produtoVersao1.png',
                            '../../public/img/produtos/produtoVersao2.png',
                            '../../public/img/produtos/produtoVersao3.png',
                            '../../public/img/produtos/produtoVersao4.png',
                            '../../public/img/produtos/produtoVersao5.png'
                        ];
                        %>

                        <img 
                            src="<%= imagens[Math.floor(Math.random() * imagens.length)] %>"
                            class="card-img-top h-100"
                            alt="<%= p.proNome %>"
                        >
                        <div class="card-body">
                            <h5 class="card-title"><%= p.proNome %></h5>
                            <p class="card-text">R$ <%= p.ProPrec %></p>
                            <a href="#" class="btn btn-produtos btn-outline-primary w-100">Ver detalhes</a>
                        </div>
                    </div>
                </div>
            <% }) %>

        </div>
    </div>
    <!-- ========================= -->
    <!-- PAGINAÇÃO -->
    <!-- ========================= -->
    
    <nav aria-label="Navegação de páginas" class="mt-4 d-flex justify-content-center">
        <ul class="pagination">
            <!-- Anterior -->
            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= currentPage - 1 %>">Anterior</a>
            </li>

            <!-- Primeira página -->
            <% if (startPage > 1) { %>
                <li class="page-item">
                    <a class="page-link" href="?page=1">1</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">...</span>
                </li>
            <% } %>

            <!-- Páginas centrais -->
            <% for(let p = startPage; p <= endPage; p++) { %>
                <li class="page-item <%= currentPage === p ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= p %>"><%= p %></a>
                </li>
            <% } %>

            <!-- Última página -->
            <% if (endPage < totalPages) { %>
                <li class="page-item">
                    <a class="page-link" href="?page=<%= totalPages %>"><%= totalPages %></a>
                </li>
            <% } %>

            <!-- Próximo -->
            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= currentPage + 1 %>">Próximo</a>
            </li>

        </ul>
    </nav>
