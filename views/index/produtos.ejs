<!DOCTYPE html>
<html lang="pt-br">

<head>
	
    <meta charset="UTF-8">
    <title>Produtos</title>

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        .product-card img {
            height: 180px;
            object-fit: cover;
        }
    </style>

</head>

<body>

    <div class="container mt-4">

        <!-- TÍTULO -->
        <h1 class="text-center mb-4">Produtos</h1>

        <!-- ========================= -->
        <!-- CARROSSEL -->
        <!-- ========================= -->
        <div id="carouselExample" class="carousel slide mb-5">
            <div class="carousel-inner">

                <% produtos.slice(0, 3).forEach((p, index) => { %>
                    <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                        <img src="<%= p.proImagem || 'https://via.placeholder.com/1200x400?text=Produto' %>" 
                             class="d-block w-100" 
                             alt="<%= p.proNome %>">
                        <div class="carousel-caption d-none d-md-block">
                            <h5><%= p.proNome %></h5>
                            <p>R$ <%= p.ProPrec %></p>
                        </div>
                    </div>
                <% }) %>

            </div>

            <!-- Controles -->
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>

            <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>


        <!-- ========================= -->
        <!-- OFERTAS -->
        <!-- ========================= -->
        <h2 class="mb-3">Ofertas</h2>
        <div class="row g-4">

            <% produtos
                .filter(p => p.emOferta === true)
                .slice(0, 6)
                .forEach(p => { %>

                <div class="col-md-4">
                    <div class="card product-card">
                        <img src="<%= p.proImagem || 'https://via.placeholder.com/300' %>" 
                             class="card-img-top" alt="...">
                        <div class="card-body">
                            <h5 class="card-title"><%= p.proNome %></h5>
                            <p class="card-text text-danger fw-bold">R$ <%= p.ProPrec %></p>
                            <a href="#" class="btn btn-primary w-100">Comprar</a>
                        </div>
                    </div>
                </div>

            <% }) %>

        </div>


        <!-- ========================= -->
        <!-- TODOS OS PRODUTOS -->
        <!-- ========================= -->
        <h2 class="mt-5 mb-3">Todos os Produtos</h2>
        <div class="row g-4">

            <% produtos.forEach(p => { %>
                <div class="col-md-3">
                    <div class="card product-card">
                        <img src="<%= p.proImagem || 'https://via.placeholder.com/300' %>" 
                             class="card-img-top" alt="<%= p.proNome %>">
                        <div class="card-body">
                            <h5 class="card-title"><%= p.proNome %></h5>
                            <p class="card-text">R$ <%= p.ProPrec %></p>
                            <a href="#" class="btn btn-outline-primary w-100">Ver detalhes</a>
                        </div>
                    </div>
                </div>
            <% }) %>

        </div>

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootst
