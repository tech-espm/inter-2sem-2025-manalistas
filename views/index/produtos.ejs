<!DOCTYPE html>
<html lang="pt-br">

<head>
	
    <meta charset="UTF-8">
    <div class="capa">
        <h1>Produtos</h1>
    </div>
    
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        .product-card img {
            height: 180px;
            object-fit: cover;
        }

        .btn:focus, .btn:hover {
            background-color: #11603e;
            color: white !important;
            transform: scale(0.97);
            outline: none !important;
        }

        .btn-produtos {
            color: #11603e !important;
            border-color: #11603e !important;
        }

        /* Centralizar bem e adicionar padding externo */
        nav[aria-label="Navegação de páginas"] {
            padding: 20px 0; /* espaço acima e abaixo */
        }

        /* Estilo padrão da paginação */
        .pagination .page-link {
            color: #11603e;               /* texto laranja */
            border-color: #11603e;        /* borda laranja */
            transition: .2s;
        }

        /* Hover */
        .pagination .page-link:hover {
            background-color: #11603e;
            color: white;
            border-color: #11603e;
        }

        /* Estado ativo (página atual) */
        .pagination .page-item.active .page-link {
            background-color: #11603e;
            border-color: #11603e;
            color: white;
        }

        /* Estado disabled (anterior/próximo desativados) */
        .pagination .page-item.disabled .page-link {
            color: white;    /* laranja mais fraco */
            border-color: #11603e;
            background-color: rgba(255,255,255, 0.5);
        }
    </style>

</head>

<body>

    <div class="container mt-4">
        <!-- TODOS OS PRODUTOS (paginados) -->
        <div class="row g-4">

            <% produtos.forEach(p => { %>
                <div class="col-md-3">
                    <div class="card product-card">

                        <%
                        const imagens = [
                            '../../public/img/produtos/produtoVersao1.png',
                            '../../public/img/produtos/produtoVersao2.png',
                            '../../public/img/produtos/produtoVersao3.png',
                            '../../public/img/produtos/produtoVersao4.png',
                            '../../public/img/produtos/produtoVersao5.png'
                        ];
                        %>

                        <img 
                            src="<%= imagens[Math.floor(Math.random() * imagens.length)] %>"
                            class="card-img-top"
                            alt="<%= p.proNome %>"
                        >
                        <div class="card-body">
                            <h5 class="card-title"><%= p.proNome %></h5>
                            <p class="card-text">R$ <%= p.ProPrec %></p>
                            <a href="#" class="btn btn-produtos btn-outline-primary w-100">Ver detalhes</a>
                        </div>
                    </div>
                </div>
            <% }) %>

        </div>
    </div>
    <!-- ========================= -->
    <!-- PAGINAÇÃO -->
    <!-- ========================= -->
    
    <nav aria-label="Navegação de páginas" class="mt-4 d-flex justify-content-center">
        <ul class="pagination">
            <!-- Anterior -->
            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= currentPage - 1 %>">Anterior</a>
            </li>

            <!-- Primeira página -->
            <% if (startPage > 1) { %>
                <li class="page-item">
                    <a class="page-link" href="?page=1">1</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">...</span>
                </li>
            <% } %>

            <!-- Páginas centrais -->
            <% for(let p = startPage; p <= endPage; p++) { %>
                <li class="page-item <%= currentPage === p ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= p %>"><%= p %></a>
                </li>
            <% } %>

            <!-- Última página -->
            <% if (endPage < totalPages) { %>
                <li class="page-item">
                    <a class="page-link" href="?page=<%= totalPages %>"><%= totalPages %></a>
                </li>
            <% } %>

            <!-- Próximo -->
            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= currentPage + 1 %>">Próximo</a>
            </li>

        </ul>
    </nav>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootst
