<div class="secao1-login">
    <div class="container1-login">
        <div class="logo-login">
            <img src="/public/img/SVG/SVG/Dog-Branco.svg" alt="Logo do Cachorro" />
            <h1 class="h1-login">Área de Membros</h1>
            <form action="/login" method="POST">
                <div class="mb-3">
                    <input class="form-control form-control-sm" type="email" id="email-login" name="email" placeholder="Digite seu e-mail" required>
                </div>
                <div class="mb-3">
                    <input class="form-control form-control-sm" type="password" id="senha-login" name="senha" placeholder="Digite sua senha" required>
                </div>
                <div>
                    <button class="btn btn-success" type="submit">Entrar</button>
                </div>
            </form>
        </div>
    </div>
</div>
