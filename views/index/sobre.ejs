				</div>
			</div>
			<div class="col-md-4">
				<div class="mb-4">
					<img id="madu" src="../public/img/perfis/madu.png" class="profile" alt="logo clube dogues" onclick="abrirPerfil(this.id)">
					<p class="perfis"> Madu </p>
				</div>
			</div>
		</div>
	</div>
	<div class="container-fluid secao3-sn">
		<div class="row">
			<h1>PANAUARAS</h1>
		</div>
		<div class="row">
			<div class="col-md-4">
				<div class="mb-2">
					<img id="ihago" src="../public/img/perfis/ihago.png" class="profile" alt="logo clube dogues" onclick="abrirPerfil(this.id)">
