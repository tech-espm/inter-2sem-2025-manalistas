			  <h3 id="card-frase"></h3>
              <p id="card-descricao"></p>
			  <div class="row">
				<div class="col-md-6">
					<div class="mb-6">
						<a id="card-linkedin" href="#" class="btn-redes" target="_blank">Ver no LinkedIn</a>
					</div>
				</div>
				<div class="col-md-6">
					<div class="mb-6">
						<a id="card-github" href="#" class="btn-redes" target="_blank">Ver no Github</a>
					</div>
				</div>
			  </div>
			  <button class="fechar-card" onclick="fecharPerfil()">&times;</button>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
<script src="public\js\perfilCard.js"></script>
