				</div>
			</div>
			<div class="col-md-4">
				<div class="mb-2">
					<img id="ihan" src="../public/img/perfis/ihan.png" class="profile" alt="logo clube dogues" onclick="abrirPerfil(this.id)">
					<p class="perfis"> Ihan </p>
				</div>
			</div>
			<div class="col-md-4">
				<div class="mb-2">
					<img id="rods" src="../public/img/perfis/rodrigo.png" class="profile" alt="logo clube dogues" onclick="abrirPerfil(this.id)">
					<p class="perfis"> Rodrigo </p>
				</div>
			</div>
		</div>
	</div>


	<div id="perfil-card" class="perfil-card" style="display:none;">
      <div class="perfil-conteudo">
        <div class="row">
          <div class="col-md-4">
            <div class="mb-4">
              <img id="card-img" src="" class="profile" alt="">
            </div>
          </div>
          <div class="col-md-8">
            <div class="mb-8">
