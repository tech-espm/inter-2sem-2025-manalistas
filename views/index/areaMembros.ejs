<!--Ihan mudança-->
<!-- Estilos do calendário -->
<style>
    .secao1-Membros{
        padding: 0px;
        max-width: 1000px;
        margin: 0px auto 20px auto;
        max-width: 1000px;
        border-radius: 20px;
    }

    .cor1 {
        background-color: var(--bege1);
    }
    .cor2 {
        background-color: var(--bege2);
    }

    .PPareaMembros {
        text-align: center;
    }

    .conteudo{
        background-color: var(--verde1);
    }

    h1 {
        color: var(--verde1);
    }
    .calendar-container {
        width: 320px;
        padding: 20px;
        border-radius: 20px;
        background: #ffffff;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .calendar-header h4 {
        margin: 0;
    }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 5px;
        text-align: center;
    }

    .calendar-day {
        padding: 8px;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.2s;
    }

    .calendar-day:hover {
        background: #e0e7ff;
    }

    .selected-day {
        background: #3b82f6 !important;
        color: white;
        font-weight: bold;
    }

    .areaCalendario {
        background-color: #527B5D; /* opcional, só pra delimitar visualmente */
        padding: 40px 30px; /* espaço interno em cima e embaixo */
    }

    .areaCentral {
        max-width: 1000px;   /* largura máxima desejada */
        margin: 0 auto;      /* centraliza horizontalmente */
        padding: 40px 0px;       /* dá um "respiro" para não ficar colado no conteúdo */
        border-radius: 20px; /* opcional */
        background-color: #033228;
    }

    .servicoCoresTexto {
        color: #ffffff
    }
    
</style>

<!-- SEÇÃO ////////////////////    -->

<div class="container-fluid text-black areaCalendario">

    
    <h1 class="text-center servicoCoresTexto">Agendar Serviços Petshop</h1>

    <div class="container-fluid verdeCalen areaCentral">  

        <div class="container">
            <div class="row justify-content-center align-items-start g-5">

                <!-- COLUNA ESQUERDA – Calendário -->
                <div class="col-12 col-md-5">
                    <div id="calendar" class="calendar-container mx-auto"></div>
                </div>

                <!-- COLUNA DIREITA – Inputs -->
                <div class="col-12 col-md-5">

                    <!-- Seleção do serviço -->
                    <label class="fw-bold servicoCoresTexto">Selecione o serviço:</label>
                    <select id="servico" class="form-select mb-4">
                        <option>Banho</option>
                        <option>Tosa</option>
                        <option>Day Care</option>
                        <option>Consulta</option>
                    </select>

                    <!-- Escolha do horário -->
                    <label class="fw-bold servicoCoresTexto">Escolha o horário:</label>
                    <select id="horario" class="form-select mb-4">
                        <option disabled selected>Selecione um horário</option>

                        <optgroup label="Manhã">
                            <option>8:30</option>
                            <option>9:30</option>
                            <option>10:30</option>
                            <option>11:30</option>
                        </optgroup>

                        <optgroup label="Tarde">
                            <option>13:30</option>
                            <option>14:30</option>
                            <option>15:30</option>
                            <option>16:30</option>
                        </optgroup>
                    </select>

                    <!-- Botão -->
                    <button id="confirmar" class="btn btn-primary w-100">Confirmar Agendamento</button>

                </div>

            </div>
        </div>

    </div>
</div>

<!-- SEÇÃO ////////////////////    -->

<!-- Script do calendário -->
<script src="\public\js\calendario.js"></script>
